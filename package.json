{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && prisma generate"
  },
  "dependencies": {
    "@nuxt/eslint": "1.0.1",
    "@nuxt/icon": "1.10.3",
    "@nuxtjs/i18n": "9.2.1",
    "@prisma/client": "^6.4.0",
    "@prisma/nuxt": "0.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "bcrypt": "^5.1.1",
    "eslint": "^9.20.1",
    "flowbite": "^3.1.2",
    "jsonwebtoken": "^9.0.2",
    "nuxt": "^3.15.4",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "6.13.1",
    "prisma": "^6.4.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.4.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "bcrypt",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "bcrypt"
    ]
  }
}
